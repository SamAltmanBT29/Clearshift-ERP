{
  "name": "@clearshift/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod/TypeScript API contracts and OpenAPI specs for ClearShift ERP",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./common": "./src/common.ts",
    "./events": "./src/events.ts",
    "./erp-1": "./src/erp-1.ts",
    "./erp-2": "./src/erp-2.ts",
    "./erp-2-events": "./src/erp-2-events.ts",
    "./erp-2-mock": "./src/erp-2-mock.ts",
    "./erp-3": "./src/erp-3.ts",
    "./erp-3-mock": "./src/erp-3-mock.ts",
    "./erp-3-events": "./src/erp-3-events.ts",
    "./erp-4": "./src/erp-4.ts",
    "./erp-4-mock": "./src/erp-4-mock.ts",
    "./erp-4-events": "./src/erp-4-events.ts",
    "./erp-5": "./src/erp-5.ts",
    "./erp-5-mock": "./src/erp-5-mock.ts",
    "./erp-5-events": "./src/erp-5-events.ts",
    "./roles": "./src/roles.ts",
    "./golden-id": "./src/golden-id.ts",
    "./import-target": "./src/import-target.ts",
    "./openapi": "./openapi"
  },
  "scripts": {
    "lint:openapi": "npx --yes @stoplight/spectral-cli@6.11.0 lint --ruleset ../../.spectral.yaml --fail-severity=warn openapi/erp-3.yaml"
