{
  "name": "@clearshift/database",
  "version": "0.1.0",
  "private": true,
  "description": "Shared database layer: Drizzle schema definitions, migrations, and client for ClearShift ERP",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./migrations"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node scripts/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
