# ClearShift ERP — Environment Configuration

# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for local development
DATABASE_URL=postgresql://clearshift:password@localhost:5432/clearshift_dev

# Test database (used by `npm run db:migrate:test`)
DATABASE_URL_TEST=postgresql://clearshift:password@localhost:5432/clearshift_test

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Set a strong random secret in production. Never use this placeholder.
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_VALUE
JWT_EXPIRY=1h
