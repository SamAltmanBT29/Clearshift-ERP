# ==============================================================================
# ClearShift V1 Development Environment Configuration (.env.example)
# Authority: Master Architecture Blueprint Baseline 1.0-A (PLT-01 / REL-01)
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 18.x
# Note: Local application runs under the 'cs_app' role (DML only)
# Database migrations run under the 'cs_migrator' role (DDL only)
POSTGRES_USER=cs_app
POSTGRES_PASSWORD=app_secret_123
POSTGRES_DB=clearshift
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cs_app:app_secret_123@localhost:5432/clearshift
DATABASE_MIGRATOR_URL=postgresql://cs_migrator:migrator_secret_123@localhost:5432/clearshift

# Redis 8.x (Streams & BullMQ Queues)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Hub Identity & Authentication (Decision C3)
# EdDSA / JWT signing secret (minimum 32 characters)
JWT_SECRET=clearshift_dev_jwt_signing_secret_min_32_characters_long
# AES encryption secret for signing keys in DB
KEY_ENC_SECRET=clearshift_dev_key_encryption_secret_min_32_bytes_

# PII & Sensitive Column Encryption (Decision C10)
# 32-byte secret for AES-256-GCM vendor bank encryption (BANK_ENC_KEY)
BANK_ENC_KEY=clearshift_dev_bank_encryption_key_32_bytes_

# Frontend URL & CORS
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Migration File Ingestion Limits (Section 4.4 / M4)
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
