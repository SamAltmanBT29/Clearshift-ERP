{
  "mapping_schema_version": 1,
  "rules_version": "1.0.0",
  "module": "erp2",
  "source_system": "SYNTH-ERP2-DIRTY-V1",
  "fixture": "sample-data/erp-2/dirty-data-v1.csv",
  "policy": {
    "fuzzy_matching": false,
    "automatic_merge": false,
    "raw_input_mutation": false,
    "duplicate_handling": "Exact candidate keys only; later duplicates get outcome review and are never loaded or merged until a human decides.",
    "total_handling": "client_total is ignored; the server recomputes total from lines with decimal half-up rounding to 2 decimals.",
    "currency_handling": "Currency is explicit on every vendor and purchase order; accepted codes USD, EUR, GBP; no FX conversion in V1.",
    "status_handling": "POST /purchase-orders always creates Draft. A clean purchase order whose post_load_status is later in Draft -> Sent -> Received -> Closed is advanced afterwards by forward-only PATCH calls. Cancellation does not exist in V1.",
    "idempotency_key": "SYNTH-ERP2-DIRTY-V1:{entity}:{source_id}"
  },
  "load_order": [
    "vendor",
    "purchase_order"
  ],
  "reference_fixtures": {
    "note": "Synthetic stand-in for the ERP-1 product catalogue. Production loads resolve products through the ERP-1 ReferenceResolver, never by reading ERP-1 tables.",
    "erp1_product_ids": [
      "11111111-1111-1111-1111-111111111111",
      "22222222-2222-2222-2222-222222222222",
      "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
    ]
  },
