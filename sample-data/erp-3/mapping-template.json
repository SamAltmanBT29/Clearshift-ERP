    "raw_input_mutation": false,
    "duplicate_handling": "Exact candidate keys only (order_number, invoice_number, payment_number); duplicates route to outcome review and are held for human decision; never merged automatically.",
    "rounding_policy": "Server-side arithmetic computed at 4-decimal-place precision (BR-ERP3-01, BR-ERP3-02). Intermediate tax calculated as subtotal * tax_rate / 100.",
    "customer_identity_policy": "Every order and invoice must reference a valid Hub Customer Golden ID (UUID) (BR-ERP3-03 / ADR-003).",
    "currency_handling": "Currency is explicit on every order, invoice, and payment; accepted ISO 4217 codes USD, EUR, INR; no FX conversion in V1.",
    "invoicing_policy": "At most one invoice per sales order in V1 (FR-ERP3-02). Invoices have mandatory due_date (>= invoice_date); Overdue status is derived when current UTC calendar date > due_date and unpaid, otherwise Open.",
    "payment_policy": "V1 accepts exactly one full payment per invoice (amount == invoice.total); partial payments and overpayments are rejected (FR-ERP3-03). Accepted full payment transitions invoice status to Paid automatically (FR-ERP3-04).",
    "formula_injection_defense": "OWASP formula injection prefixes (=, +, -, @, \\t, \\r) in notes and references are neutralized per PLT-12 / KIT-16.",
    "idempotency_key": "SYNTH-ERP3-DIRTY-V1:{entity}:{source_id}"
  },
