            "metre": "metre",
            "meter": "metre",
            "box": "box",
            "boxes": "box"
          }
        },
        "currency": {
          "allowed": [
            "USD",
            "EUR",
            "GBP",
            "INR"
          ],
          "map": {
            "USD": "USD",
            "EUR": "EUR",
            "GBP": "GBP",
            "INR": "INR",
            "usd": "USD",
            "eur": "EUR",
            "gbp": "GBP",
            "inr": "INR"
          }
        }
      }
    },
    {
      "name": "erp1-stock-levels-import",
      "version": "1.0.0",
      "entity": "stock_level",
      "fields": [
        {
          "source": "sku",
          "target": "sku",
          "type": "string",
          "required": true
        },
        {
          "source": "warehouse_code",
          "target": "warehouse_code",
          "type": "string",
          "required": true
        },
        {
          "source": "quantity",
          "target": "quantity",
          "type": "decimal",
          "required": true,
          "decimalScale": 4
        },
        {
          "source": "as_of_date",
          "target": "as_of_date",
