{
  "name": "clearshift-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClearShift ERP — monorepo root",
  "workspaces": [
    "apps/*",
    "apps/erp/modules/*",
    "packages/*"
  ],
  "scripts": {
    "compose:up": "docker compose -f infra/compose.yaml up -d --wait",
    "compose:down": "docker compose -f infra/compose.yaml down -v",
    "db:migrate": "node packages/database/scripts/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node packages/database/scripts/migrate.js",
    "db:seed": "node --experimental-strip-types infra/scripts/seed.ts",
    "db:reset": "npm run compose:down && npm run compose:up && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:frontend": "node scripts/validate-frontend.js",
    "mock:erp-4": "node --experimental-strip-types scripts/mock-erp-4.ts",
    "security:scan": "node --experimental-strip-types infra/security/scan-secrets.ts",
    "erp1:test": "vitest run apps/erp/modules/erp-1",
    "erp1:seed": "node sample-data/erp-1/seed.ts",
    "erp2:test": "vitest run apps/erp/modules/erp-2",
    "erp2:seed": "node sample-data/erp-2/seed.ts",
    "erp2:e2e": "playwright test -c apps/erp/modules/erp-2/e2e/playwright.config.ts",
    "erp3:e2e": "playwright test -c apps/erp/modules/erp-3/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "2.1.9",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "jsdom": "29.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
