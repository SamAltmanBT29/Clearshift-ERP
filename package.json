{
  "name": "clearshift-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClearShift ERP — monorepo root",
  "workspaces": [
    "apps/*",
    "apps/erp/modules/*",
    "packages/*"
  ],
  "scripts": {
    "compose:up": "docker compose -f infra/compose.yaml up -d --wait",
    "compose:down": "docker compose -f infra/compose.yaml down -v",
    "db:migrate": "node packages/database/scripts/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node packages/database/scripts/migrate.js",
    "db:seed": "node --experimental-strip-types infra/scripts/seed.ts",
    "db:reset": "npm run compose:down && npm run compose:up && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:frontend": "node scripts/validate-frontend.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
